---
// Academic / social badges for a person. Only the ones that are filled in show.
interface Props {
  data: {
    email?: string;
    scholar?: string;
    orcid?: string;
    linkedin?: string;
    website?: string;
  };
}
const { data } = Astro.props;
const has = data.email || data.scholar || data.orcid || data.linkedin || data.website;
---
{has && (
  <div class="badges">
    {data.orcid && (
      <a class="badge badge--orcid" href={data.orcid} target="_blank" rel="noopener" aria-label="ORCID profile">
        <svg width="15" height="15" viewBox="0 0 256 256" aria-hidden="true"><path fill="#A6CE39" d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z"/><path fill="#FFF" d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.4h24.5c34.9 0 42.9-26.5 42.9-39.8 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.5zM88.7 56.8c0 5.5-4.5 10.1-10.1 10.1-5.6 0-10.1-4.6-10.1-10.1 0-5.6 4.5-10.1 10.1-10.1 5.6 0 10.1 4.6 10.1 10.1z"/></svg>
        ORCID
      </a>
    )}
    {data.scholar && (
      <a class="badge" href={data.scholar} target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 512 512" aria-hidden="true"><path fill="#4285F4" d="M256 41 0 187l256 146 209-119v138h47V187z"/><path fill="#4285F4" d="M128 278v107c0 35 57 64 128 64s128-29 128-64V278l-128 73z"/></svg>
        Google Scholar
      </a>
    )}
    {data.linkedin && (
      <a class="badge" href={data.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    )}
    {data.website && (
      <a class="badge" href={data.website} target="_blank" rel="noopener">Website</a>
    )}
    {data.email && (
      <a class="badge" href={`mailto:${data.email}`}>✉ Email</a>
    )}
  </div>
)}
