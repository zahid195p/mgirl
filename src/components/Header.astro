---
import { site } from '../lib/site';
import { url } from '../lib/url';

// current path without the base prefix, normalised, for active-link matching
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let current = Astro.url.pathname.replace(/\/$/, '') || '/';
if (base && current.startsWith(base)) current = current.slice(base.length) || '/';

function isActive(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-label={site.longName}>
      <span class="brand__mark" aria-hidden="true">🪲</span>
      <span>
        <span class="brand__name">{site.name}</span>
        <span class="brand__sub">Insecticide Resistance Lab</span>
      </span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={url('/search')} aria-label="Search" title="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
      </a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-icon="sun">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-icon="moon" style="display:none">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
