---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import ProfileBadges from '../../components/ProfileBadges.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}

const { person } = Astro.props;
const d = person.data;
const { Content } = await render(person);

// derive this person's publications (single source of truth lives on each paper)
const theirPubs = (await getCollection('publications'))
  .filter((p) => (p.data.labAuthors ?? []).some((ref) => ref.id === person.id))
  .sort((a, b) => b.data.year - a.data.year);

const theirProjects = (await getCollection('projects')).filter(
  (p) => p.data.lead?.id === person.id || (p.data.members ?? []).some((m) => m.id === person.id),
);
---
<BaseLayout title={d.name} description={`${d.role}${d.title ? ' — ' + d.title : ''}`}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href={url('/people')}>People</a> / {d.name}</p>
      <div class="with-aside">
        <div>
          <div style="display:flex; gap:1.25rem; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap;">
            <Avatar name={d.name} photo={d.photo} size={112} />
            <div>
              <h1 style="margin-bottom:0.1rem;">{d.name}</h1>
              <p class="lead" style="margin:0;">{d.role}</p>
              {d.title && <p class="muted" style="margin:0;">{d.title}</p>}
              <ProfileBadges data={d} />
            </div>
          </div>

          <div class="prose"><Content /></div>

          {theirPubs.length > 0 && (
            <div style="margin-top:2.25rem;">
              <h2 style="font-size:1.4rem;">Publications</h2>
              {theirPubs.map((pub) => <PublicationItem pub={pub} />)}
            </div>
          )}

          {theirProjects.length > 0 && (
            <div style="margin-top:2.25rem;">
              <h2 style="font-size:1.4rem;">Projects</h2>
              <ul class="stack" style="padding-left:1.1rem;">
                {theirProjects.map((pr) => (
                  <li><a href={url(`/projects/${pr.id}`)}>{pr.data.title}</a> <span class="muted">— {pr.data.status}</span></li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <aside class="aside-card">
          {d.interests.length > 0 && (
            <div style="margin-bottom:1.1rem;">
              <h4 style="margin-top:0;">Research interests</h4>
              <div class="chip-row">{d.interests.map((i) => <span class="tag tag--muted">{i}</span>)}</div>
            </div>
          )}
          {d.joined && <p class="muted" style="font-size:0.85rem; margin-top:0;">In the lab since {d.joined}</p>}
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
