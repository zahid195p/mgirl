---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tile from '../../components/Tile.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const albums = await getCollection('gallery');
  return albums.map((a) => ({ params: { slug: a.id }, props: { album: a } }));
}

const { album } = Astro.props;
const d = album.data;
const { Content } = await render(album);
const dateStr = d.date ? d.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' }) : '';
---
<BaseLayout title={d.title} description={`Photo album: ${d.title}`}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href={url('/gallery')}>Gallery</a> / {d.title}</p>
      <h1>{d.title}</h1>
      {dateStr && <p class="muted">{dateStr}</p>}
      <div class="prose"><Content /></div>

      <div class="gallery-grid" style="margin-top:1.25rem;">
        {d.images.map((img) => <Tile image={img.image} caption={img.caption} ratio="1 / 1" />)}
      </div>

      <p style="margin-top:2rem;"><a class="btn btn--ghost" href={url('/gallery')}>← All albums</a></p>
    </div>
  </section>
</BaseLayout>
