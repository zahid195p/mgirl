---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="section" style="text-align:center;">
    <div class="container narrow">
      <p style="font-size:4rem; margin:0;">🪲</p>
      <h1>Page not found</h1>
      <p class="lead">The page you were looking for doesn’t exist or may have moved.</p>
      <p><a class="btn btn--primary" href={url('/')}>Back to home</a></p>
    </div>
  </section>
</BaseLayout>
